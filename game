                    Tone.start();
                }
                if (type === 'move') {
                    synth.triggerAttackRelease("C4", "8n");
                } else if (type === 'grab') {
                    synth.triggerAttackRelease("G3", "8n");
                } else if (type === 'correct') {
                    const now = Tone.now();
                    synth.triggerAttackRelease("E5", "8n", now);
                    synth.triggerAttackRelease("G5", "8n", now + 0.15);
                } else if (type === 'wrong') {
                    synth.triggerAttackRelease("C3", "4n");
                }
            } catch (e) {
                // Audio fallback
            }
        }

